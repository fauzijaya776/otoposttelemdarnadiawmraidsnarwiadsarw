# === Bot pengendali (dari @BotFather) ===
# Kirim /newbot ke @BotFather, salin tokennya ke sini.
BOT_TOKEN=

# ID Telegram Anda sebagai owner. Boleh dikosongkan, lalu kirim /claim ke bot.
OWNER_ID=

# === Akun pengirim (dari https://my.telegram.org/apps) ===
# Akun inilah yang benar-benar mengirim postingan ke grup.
API_ID=
API_HASH=

# WAJIB untuk hosting tanpa disk permanen (Render free tier, Railway, dll):
# berkas data/session.txt terhapus tiap restart, jadi sesi disimpan di sini.
# Cara mengisi: jalankan "npm run login" di komputer, lalu "npm run sesi",
# salin nilainya ke sini / ke Environment di dashboard hosting.
# Nilai ini setara akses penuh ke akun Telegram Anda — jangan dibagikan.
SESSION_STRING=

# Port health check untuk hosting (Render/Railway). Boleh dibiarkan.
PORT=3000

# Zona waktu untuk tampilan jam
TZ=Asia/Jakarta
